# The update helper's verify unit (docs/design/deployment.md, "Updating from Settings"): copies the
# release the server downloaded into its own folder, verifies its signature with the keys the
# release in use pins, unpacks it there, and starts not-unreachable-update-apply.service. The
# service user starts it through polkit, and only while UPDATE_FROM_UI=true
# (deploy/polkit/52-not-unreachable-update.rules); it is never enabled, so it has no [Install]
# section. Everything it reads from the service user is hostile, so it has almost no rights: it
# writes only its state folder and changes nothing on the host.
[Unit]
Description=not-unreachable: verify an update

[Service]
Type=oneshot
ExecStart=/usr/bin/node /usr/lib/not-unreachable/update-helper.mjs verify
# Copying a 256 MiB tarball, hashing it and reading the archive twice, on a slow disk.
TimeoutStartSec=10min
# System units start with an empty environment; PATH is the only variable, so systemctl is found
# in the system's own directories.
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
UMask=0022
# Root's own folder, readable by all so the server can read status.json; work/ in it is 0700.
StateDirectory=not-unreachable-update
StateDirectoryMode=0755

NoNewPrivileges=yes
# Root, but with one capability: CAP_DAC_READ_SEARCH reads the service user's 0600 request and
# spool files in their 0700 folders. Root owns the state folder, so writing there needs nothing
# more.
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=
# Everything but the state folder is read-only.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
# It needs no network at all. systemctl reaches PID 1 over /run/systemd/private, a socket in the
# file system, which a network namespace doesn't hide.
PrivateNetwork=yes
IPAddressDeny=any
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
# What Node and systemctl need (open, read, write, rename, fsync, fchmod, statfs, socket I/O); none
# of them changes owners, user ids or mounts.
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @mount
# V8's JIT needs writable+executable memory, so MemoryDenyWriteExecute stays off.
MemoryDenyWriteExecute=no
