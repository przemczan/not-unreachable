/* Generated by scripts/build-tokens.ts from tokens/tokens.json. Edit those, then run `pnpm tokens`. */
@import "tailwindcss";
@import "./tokens.css";

/* The theme follows data-theme on <html>, not the system setting (see AppShell's theme switch). */
@custom-variant dark (&:where([data-theme=dark], [data-theme=dark] *));

@font-face {
  font-family: "Geist";
  src: url("./fonts/Geist-Variable.woff2") format("woff2");
  font-weight: 100 900;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: "Geist Mono";
  src: url("./fonts/GeistMono-Variable.woff2") format("woff2");
  font-weight: 100 900;
  font-style: normal;
  font-display: swap;
}

@theme inline reference {
  --color-*: initial;
  --container-*: initial;
  --radius-*: initial;
  --shadow-*: initial;
  --inset-shadow-*: initial;
  --drop-shadow-*: initial;
  --text-shadow-*: initial;
  --blur-*: initial;
  --text-*: initial;
  --font-*: initial;
  --leading-*: initial;
  --tracking-*: initial;
  --ease-*: initial;
  --animate-*: initial;
  --font-sans: "Geist", ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
  --font-mono: "Geist Mono", ui-monospace, "SF Mono", Menlo, Consolas, monospace;
  --radius-control: var(--radius-control);
  --radius-card: var(--radius-card);
  --radius-dialog: var(--radius-dialog);
  --radius-badge: var(--radius-badge);
  --color-bg: var(--bg);
  --color-surface: var(--surface);
  --color-surface-raised: var(--surface-raised);
  --color-surface-sunken: var(--surface-sunken);
  --color-surface-hover: var(--surface-hover);
  --color-surface-selected: var(--surface-selected);
  --color-surface-inverse: var(--surface-inverse);
  --color-sidebar: var(--sidebar-bg);
  --color-sidebar-fg: var(--sidebar-fg);
  --color-sidebar-active: var(--sidebar-active-bg);
  --color-sidebar-active-fg: var(--sidebar-active-fg);
  --color-fg-1: var(--fg-1);
  --color-fg-2: var(--fg-2);
  --color-fg-3: var(--fg-3);
  --color-fg-disabled: var(--fg-disabled);
  --color-fg-inverse: var(--fg-inverse);
  --color-fg-on-accent: var(--fg-on-accent);
  --color-border: var(--border);
  --color-border-subtle: var(--border-subtle);
  --color-border-strong: var(--border-strong);
  --color-border-control: var(--border-control);
  --color-border-focus: var(--border-focus);
  --color-accent: var(--accent);
  --color-accent-hover: var(--accent-hover);
  --color-accent-press: var(--accent-press);
  --color-accent-fill: var(--accent-fill);
  --color-accent-fill-hover: var(--accent-fill-hover);
  --color-accent-fill-press: var(--accent-fill-press);
  --color-accent-subtle: var(--accent-subtle);
  --color-accent-subtle-fg: var(--accent-subtle-fg);
  --color-primary: var(--primary);
  --color-primary-hover: var(--primary-hover);
  --color-primary-press: var(--primary-press);
  --color-primary-fg: var(--primary-fg);
  --color-control-hover: var(--control-hover);
  --color-control-press: var(--control-press);
  --color-success: var(--success);
  --color-success-subtle: var(--success-subtle);
  --color-success-fg: var(--success-fg);
  --color-success-border: var(--success-border);
  --color-warning: var(--warning);
  --color-warning-subtle: var(--warning-subtle);
  --color-warning-fg: var(--warning-fg);
  --color-warning-border: var(--warning-border);
  --color-danger: var(--danger);
  --color-danger-hover: var(--danger-hover);
  --color-danger-press: var(--danger-press);
  --color-danger-subtle: var(--danger-subtle);
  --color-danger-fg: var(--danger-fg);
  --color-danger-border: var(--danger-border);
  --color-info: var(--info);
  --color-info-subtle: var(--info-subtle);
  --color-info-fg: var(--info-fg);
  --color-info-border: var(--info-border);
  --color-neutral-subtle: var(--neutral-subtle);
  --color-neutral-fg: var(--neutral-fg);
  --color-neutral-border: var(--neutral-border);
  --color-link: var(--text-link);
  --color-link-hover: var(--text-link-hover);
  --color-overlay: var(--overlay);
  --color-positive: var(--positive);
  --color-negative: var(--negative);
  --spacing: var(--space-1);
  --spacing-control-xs: var(--control-xs);
  --spacing-control-sm: var(--control-sm);
  --spacing-control-md: var(--control-md);
  --spacing-control-lg: var(--control-lg);
  --spacing-row-compact: var(--row-compact);
  --spacing-row: var(--row-default);
  --spacing-row-relaxed: var(--row-relaxed);
  --spacing-sidebar: var(--sidebar-width);
  --spacing-sidebar-collapsed: var(--sidebar-collapsed);
  --spacing-topbar: var(--topbar-height);
  --spacing-page: var(--page-padding);
  --spacing-card: var(--card-padding);
  --container-content: var(--content-max);
  --radius-full: var(--radius-full);
  --shadow-control: var(--shadow-1);
  --shadow-raised: var(--shadow-2);
  --shadow-floating: var(--shadow-3);
  --shadow-focus: var(--focus-ring);
  --font-weight-normal: var(--weight-regular);
  --font-weight-medium: var(--weight-medium);
  --font-weight-semibold: var(--weight-semibold);
  --leading-tight: var(--leading-tight);
  --leading-snug: var(--leading-snug);
  --leading-normal: var(--leading-normal);
  --tracking-tight: var(--tracking-tight);
  --tracking-normal: var(--tracking-normal);
  --tracking-caps: var(--tracking-caps);
  --ease-out: var(--ease-out);
  --ease-in-out: var(--ease-in-out);
  --animate-spin: nu-spin 1s linear infinite;
  --default-transition-duration: var(--duration-fast);
  --default-transition-timing-function: var(--ease-out);
}

@keyframes nu-spin {
  to {
    transform: rotate(360deg);
  }
}

@utility type-page-title {
  font: var(--type-page-title);
  letter-spacing: var(--tracking-tight);
}
@utility type-section-title {
  font: var(--type-section-title);
  letter-spacing: var(--tracking-normal);
}
@utility type-card-title {
  font: var(--type-card-title);
  letter-spacing: var(--tracking-normal);
}
@utility type-body {
  font: var(--type-body);
  letter-spacing: var(--tracking-normal);
}
@utility type-body-sm {
  font: var(--type-body-sm);
  letter-spacing: var(--tracking-normal);
}
@utility type-label {
  font: var(--type-label);
  letter-spacing: var(--tracking-normal);
}
@utility type-caption {
  font: var(--type-caption);
  letter-spacing: var(--tracking-normal);
}
@utility type-metric {
  font: var(--type-metric);
  letter-spacing: var(--tracking-tight);
}
@utility type-metric-sm {
  font: var(--type-metric-sm);
  letter-spacing: var(--tracking-tight);
}
@utility type-overline {
  font: var(--type-overline);
  letter-spacing: var(--tracking-caps);
  text-transform: uppercase;
}
@utility type-mono {
  font: var(--type-mono);
  letter-spacing: var(--tracking-normal);
}

@utility duration-instant {
  transition-duration: var(--duration-instant);
}
@utility duration-fast {
  transition-duration: var(--duration-fast);
}
@utility duration-base {
  transition-duration: var(--duration-base);
}
@utility duration-slow {
  transition-duration: var(--duration-slow);
}
@utility z-base {
  z-index: var(--z-base);
}
@utility z-sticky {
  z-index: var(--z-sticky);
}
@utility z-dropdown {
  z-index: var(--z-dropdown);
}
@utility z-drawer {
  z-index: var(--z-drawer);
}
@utility z-modal {
  z-index: var(--z-modal);
}
@utility z-toast {
  z-index: var(--z-toast);
}
@utility z-tooltip {
  z-index: var(--z-tooltip);
}

@layer base {
  *,
  ::before,
  ::after {
    border-color: var(--border);
  }

  html {
    color-scheme: light;
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
  }

  html[data-theme="dark"] {
    color-scheme: dark;
  }

  body {
    background: var(--bg);
    color: var(--fg-1);
    font: var(--type-body);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    font-feature-settings: "cv11";
  }

  a {
    color: var(--text-link);
    text-decoration: underline;
    text-decoration-thickness: var(--border-width);
    text-underline-offset: 3px;
    text-decoration-color: var(--border-strong);
  }

  a:hover {
    color: var(--text-link-hover);
    text-decoration-color: currentColor;
  }

  code,
  kbd,
  pre,
  samp {
    font-family: var(--font-mono);
  }

  ::selection {
    background: color-mix(in oklab, var(--accent) 25%, transparent);
  }

  :focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  h1,
  h2,
  h3,
  h4,
  p {
    text-wrap: pretty;
  }

  dialog {
    margin: auto;
    padding: 0;
    border: none;
    background: transparent;
    max-width: calc(100vw - 2rem);
  }

  dialog::backdrop {
    background: var(--overlay);
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation: none !important;
      transition: none !important;
    }
  }
}
