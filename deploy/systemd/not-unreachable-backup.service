# The daily database backup (docs/design/deployment.md, "Backups"): `not-unreachable backup` writes
# backups/not-unreachable-<UTC timestamp>.sqlite with VACUUM INTO and keeps the last 7. Started by
# not-unreachable-backup.timer. It runs as the service user with the service's hardening and
# credential, so it sees exactly what the service sees.
[Unit]
Description=NotUnreachable database backup
After=not-unreachable.service

[Service]
Type=oneshot
User=not-unreachable
Group=not-unreachable
WorkingDirectory=/opt/not-unreachable/current
ExecStart=/usr/bin/node --disable-proto=delete dist/cli.js backup
EnvironmentFile=/etc/not-unreachable/config.env
Environment=NODE_ENV=production
LoadCredential=master.key:/etc/not-unreachable/credentials/master.key
StateDirectory=not-unreachable
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec=1h

# Hardening: as not-unreachable.service. No RuntimeDirectory= (stopping this unit would remove the
# service's /run/not-unreachable) and no RemoveIPC= (it would remove the running service's IPC
# objects, which belong to the same user).
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @mount
# V8's JIT needs writable+executable memory, so MemoryDenyWriteExecute stays off.
MemoryDenyWriteExecute=no
