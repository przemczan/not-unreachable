    "@not-unreachable/contracts": "workspace:*",
    "@not-unreachable/mount-helper": "workspace:*",
    "@simplewebauthn/server": "13.3.3",
    "@tus/file-store": "2.1.2",
    "@tus/server": "2.4.7",
    "@tus/utils": "0.7.3",
    "better-sqlite3": "13.2.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "nodemailer": "10.6.1",
    "openid-client": "6.9.1",
