    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@not-unreachable/tsconfig": "workspace:*",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/node": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/fontkit": "2.0.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fontkit": "3.0.0",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
